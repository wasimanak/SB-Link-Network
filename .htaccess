# ==========================================
# SB Link Network / NetBee Web Configuration
# ==========================================

Options -Indexes -MultiViews +FollowSymLinks

<IfModule mod_rewrite.c>
RewriteEngine On

# Pass Authorization Header to PHP (Required for REST APIs, Bearer & ServerKey Tokens)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /

# 1. Force HTTPS on live domain (lasani.tech, sblink.tech, etc. - skips raw IP)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^[0-9.:]+$
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Automatically route customer.sblink.tech to /customer/ folder
RewriteCond %{HTTP_HOST} ^customer\. [NC]
RewriteCond %{REQUEST_URI} !^/customer/ [NC]
RewriteRule ^(.*)$ customer/$1 [L,QSA]

# 3. Block Automated Vulnerability Scanners & Exploit Tools (SQLMap, Nikto, DirBuster, etc.)
RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|wpscan|masscan|zgrab|acunetix|nessus|nmap|havij|dirbuster|python-requests) [NC]
RewriteRule .* - [F,L]

# 4. Redirect root /index.php to /
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} !/security_gate [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+/index\.php [NC]
RewriteRule ^index\.php$ / [R=301,L]

# 5. Redirect subfolder /path/index.php to /path/
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} !/security_gate [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?\s]+)/index\.php [NC]
RewriteRule ^ %1/ [R=301,L]

# 6. External 301 Redirect: Remove .php from URL in browser address bar
# (Only redirect browser GET/HEAD requests; skip POST so form payloads are preserved)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} !/index\.php [NC]
RewriteCond %{THE_REQUEST} !/api_ [NC]
RewriteCond %{THE_REQUEST} !ajax [NC]
RewriteCond %{THE_REQUEST} !/security_gate [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?\s]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 6b. Admin to Operator Alias Routing (preserves backwards compatibility)
RewriteRule ^admin/settings/?$ operator/profile.php [L,QSA]
RewriteRule ^admin/backups/?$ operator/backups.php [L,QSA]
RewriteRule ^operator/backups/?$ operator/backups.php [L,QSA]
RewriteRule ^admin/reminders/?$ operator/reminders.php [L,QSA]
RewriteRule ^operator/reminders/?$ operator/reminders.php [L,QSA]
RewriteRule ^api/sms_gateway(/.*)?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^api/mobile/v1(/.*)?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^mobile/v1(/.*)?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^health/?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^api/health/?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^message(/.*)?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^device(/.*)?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^events(/.*)?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^settings(/.*)?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^webhooks(/.*)?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^inbox(/.*)?$ operator/api_sms_gateway.php [L,QSA]
RewriteRule ^admin/?$ operator/dashboard.php [L,QSA]
RewriteRule ^admin/(.*)$ operator/$1 [L,QSA]
RewriteRule ^superadmin/admins/?$ superadmin/operators.php [L,QSA]
RewriteRule ^superadmin/admin_add/?$ superadmin/operator_add.php [L,QSA]
RewriteRule ^superadmin/admin_edit/?$ superadmin/operator_edit.php [L,QSA]
RewriteRule ^superadmin/backups/?$ superadmin/backups.php [L,QSA]

# 6c. MASTER SYSTEM CYBER SECURITY SHIELD
# Protect all root-level utility, maintenance, and database scripts against unauthorized access
# Whitelist public entry points, policies, legitimate webhooks, and cron endpoints
RewriteCond %{REQUEST_URI} !^/(index|login|logout|security_gate|safepay_webhook|reset_all_usage_db|cron_sync_mikrotik|health|message|device|events|settings|webhooks|inbox|privacy-policy|terms-and-conditions|terms|contact|refund-policy|shipping-policy|faqs|policies)(\.php)?$ [NC]
# Whitelist portal subfolders and static assets
RewriteCond %{REQUEST_URI} !^/(api|mobile|customer|admin|operator|dealer|superadmin|recoveryman|lineman|uploads|assets|css|js|images)/ [NC]
# Intercept any requested root PHP script
RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^([a-zA-Z0-9_-]+)(\.php)?$ security_gate.php?target=$1 [QSA,L]

# 7. Internal Rewrite: Route /path/file to /path/file.php if file.php exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f [OR]
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.*?)/?$ $1.php [L,QSA]

</IfModule>

# ==========================================
# SECURITY HARDENING DIRECTIVES
# ==========================================

# Block access to sensitive database dumps, logs, configs, and hidden files
<FilesMatch "\.(sql|log|ini|env|bak|sh|git.*|md|dump)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers to prevent clickjacking & MIME-sniffing attacks
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>


# ==========================================
# PERFORMANCE: GZIP COMPRESSION AND BROWSER CACHE
# ==========================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/ttf "access plus 1 month"
</IfModule>
