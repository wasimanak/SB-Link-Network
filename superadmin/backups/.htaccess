# Deny direct web access to raw database backup files
<FilesMatch "\.(sql|dump|bak|gz|tar|zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
